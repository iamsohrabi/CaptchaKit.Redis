<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>1.0.0</Version>
    <PackageId>CaptchaKit.Redis</PackageId>
    <Authors>Mehrdad Sohrabi</Authors>
    <Description>Redis-backed CAPTCHA storage for CaptchaKit with expiration and single-use validation.</Description>
    <PackageOutputPath>../Packages</PackageOutputPath>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CaptchaKit" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CaptchaKit.Redis.Tests" />
  </ItemGroup>

</Project>
